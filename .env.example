# =====================================================================
# Mini-RAG PDF Chatbot Environment Configuration
# =====================================================================

# Google Gemini API Key
# Used for final grounded natural-language answer generation
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter API Key
# Used to access the TypeSafe Jev System One decision model through OpenRouter Decisions API
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Jev Model Identifier
# Configurable model alias or version (e.g., ~typesafe/jev-latest or typesafe/jev-1.13)
JEV_MODEL=~typesafe/jev-latest

# Optional Development Debugging
# Set to 'true' to include detailed decision trace objects in API responses
DEBUG_DECISIONS=true

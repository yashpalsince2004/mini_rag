---
// Mini RAG - Astro Frontend
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mini RAG — PDF Chatbot</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>
  <div class="app-container">
    <!-- Header -->
    <header class="app-header">
      <div class="header-content">
        <div class="badge">EDUCATIONAL RAG</div>
        <h1>Mini RAG</h1>
        <p class="subtitle">Ask questions about your PDF with local ChromaDB retrieval and Gemini</p>
      </div>
    </header>

    <main class="main-content">
      <!-- Document Selection Card -->
      <section class="card selection-card">
        <div class="card-header">
          <span class="section-label">SELECT DOCUMENT</span>
        </div>
        <div class="selector-row">
          <div class="select-wrapper">
            <select id="doc-select" disabled>
              <option value="">Loading available PDFs...</option>
            </select>
          </div>
          <button id="load-btn" class="btn btn-primary" disabled>
            <span class="btn-text">Load Document</span>
          </button>
        </div>

        <!-- Status & Document Info -->
        <div id="doc-status-banner" class="status-banner info hidden">
          <div class="status-indicator"></div>
          <div class="status-text">
            <strong id="doc-name">No document selected</strong>
            <span id="doc-meta" class="meta-text">Select a PDF to start chatting</span>
          </div>
        </div>

        <!-- Error Notification -->
        <div id="error-banner" class="status-banner error hidden">
          <span class="error-icon">⚠️</span>
          <span id="error-message">An error occurred</span>
        </div>
      </section>

      <!-- Chat Section -->
      <section class="card chat-card">
        <div class="chat-header">
          <span class="section-label">CONVERSATION</span>
          <button id="clear-btn" class="btn btn-secondary btn-sm" disabled>Clear Chat</button>
        </div>

        <!-- Messages Area -->
        <div id="chat-messages" class="chat-messages">
          <div id="empty-state" class="empty-state">
            <div class="empty-icon">📄</div>
            <h3>No Document Loaded</h3>
            <p>Select a PDF file above and click <strong>Load Document</strong> to initialize the RAG vector index.</p>
          </div>
        </div>

        <!-- Chat Input Form -->
        <form id="chat-form" class="chat-input-form">
          <input
            type="text"
            id="query-input"
            class="chat-input"
            placeholder="Select a document first..."
            autocomplete="off"
            disabled
          />
          <button type="submit" id="send-btn" class="btn btn-primary send-btn" disabled>
            <span>Send</span>
          </button>
        </form>
      </section>
    </main>

    <footer class="app-footer">
      <span>Pipeline: PyMuPDF → Word Chunking → Sentence Transformers (all-MiniLM-L6-v2) → ChromaDB → Gemini 2.5 Flash</span>
    </footer>
  </div>

  <script>
    import { marked } from "marked";

    // Configure marked for smooth chat formatting
    marked.use({
      breaks: true,
      gfm: true
    });

    const API_BASE = "http://localhost:8000";

    // State
    let currentDocument = null;
    let isProcessing = false;
    let isGenerating = false;
    let messages = [];

    // DOM Elements
    const docSelect = document.getElementById("doc-select") as HTMLSelectElement;
    const loadBtn = document.getElementById("load-btn") as HTMLButtonElement;
    const docStatusBanner = document.getElementById("doc-status-banner") as HTMLElement;
    const docName = document.getElementById("doc-name") as HTMLElement;
    const docMeta = document.getElementById("doc-meta") as HTMLElement;
    const errorBanner = document.getElementById("error-banner") as HTMLElement;
    const errorMessage = document.getElementById("error-message") as HTMLElement;
    const chatMessages = document.getElementById("chat-messages") as HTMLElement;
    const chatForm = document.getElementById("chat-form") as HTMLFormElement;
    const queryInput = document.getElementById("query-input") as HTMLInputElement;
    const sendBtn = document.getElementById("send-btn") as HTMLButtonElement;
    const clearBtn = document.getElementById("clear-btn") as HTMLButtonElement;

    function showError(msg: string) {
      if (!msg) {
        errorBanner.classList.add("hidden");
        return;
      }
      errorMessage.textContent = msg;
      errorBanner.classList.remove("hidden");
    }

    function clearError() {
      errorBanner.classList.add("hidden");
    }

    // 1. Fetch available documents from FastAPI
    async function fetchDocuments() {
      try {
        clearError();
        const res = await fetch(`${API_BASE}/api/documents`);
        if (!res.ok) throw new Error(`Backend error (${res.status}): Failed to load documents.`);
        const data = await res.json();
        
        docSelect.innerHTML = "";
        if (!data.documents || data.documents.length === 0) {
          docSelect.innerHTML = '<option value="">No PDF files found in documents/</option>';
          docSelect.disabled = true;
          loadBtn.disabled = true;
          return;
        }

        const defaultOption = document.createElement("option");
        defaultOption.value = "";
        defaultOption.textContent = "Select a PDF...";
        docSelect.appendChild(defaultOption);

        data.documents.forEach((doc: { name: string }) => {
          const opt = document.createElement("option");
          opt.value = doc.name;
          opt.textContent = doc.name;
          docSelect.appendChild(opt);
        });

        docSelect.disabled = false;
      } catch (err: any) {
        docSelect.innerHTML = '<option value="">Cannot connect to backend</option>';
        showError(`Backend connection failed: Make sure FastAPI is running on ${API_BASE}. (${err.message})`);
      }
    }

    docSelect.addEventListener("change", () => {
      loadBtn.disabled = !docSelect.value || isProcessing;
    });

    // 2. Select & Ingest Document
    loadBtn.addEventListener("click", async () => {
      const selected = docSelect.value;
      if (!selected || isProcessing) return;

      isProcessing = true;
      loadBtn.disabled = true;
      docSelect.disabled = true;
      clearError();

      // Show indexing status
      docStatusBanner.className = "status-banner info";
      docName.textContent = selected;
      docMeta.textContent = "Processing document: Extracting text, chunking, and embedding in ChromaDB...";
      docStatusBanner.classList.remove("hidden");

      try {
        const res = await fetch(`${API_BASE}/api/documents/select`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ filename: selected })
        });

        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.detail || `Server error (${res.status})`);
        }

        const data = await res.json();
        currentDocument = data.name;

        // Update banner to ready
        docStatusBanner.className = "status-banner success";
        docName.textContent = data.name;
        docMeta.textContent = `${data.pages} pages • ${data.chunks} chunks • Ready to chat`;
        
        // Enable chat
        queryInput.disabled = false;
        queryInput.placeholder = `Ask something about ${data.name}...`;
        sendBtn.disabled = false;
        clearBtn.disabled = false;

        // Reset chat for new document
        messages = [];
        renderMessages();
        queryInput.focus();
      } catch (err: any) {
        docStatusBanner.className = "status-banner error";
        docName.textContent = selected;
        docMeta.textContent = "Failed to ingest document";
        showError(`Ingestion error: ${err.message}`);
      } finally {
        isProcessing = false;
        docSelect.disabled = false;
        loadBtn.disabled = !docSelect.value;
      }
    });

    // 3. Chat Messages Rendering with Markdown support
    function renderMessages() {
      if (messages.length === 0) {
        chatMessages.innerHTML = "";
        const welcome = document.createElement("div");
        welcome.className = "empty-state";
        welcome.innerHTML = `
          <div class="empty-icon">💬</div>
          <h3>Ready to Chat</h3>
          <p>Ask a question about <strong>${currentDocument || "the document"}</strong> below.</p>
        `;
        chatMessages.appendChild(welcome);
        clearBtn.disabled = true;
        return;
      }

      clearBtn.disabled = false;
      chatMessages.innerHTML = "";

      messages.forEach((msg: { role: string; content: string; sources?: number[] }) => {
        const row = document.createElement("div");
        row.className = `message-row ${msg.role}`;

        const bubble = document.createElement("div");
        bubble.className = "message-bubble";

        const sender = document.createElement("div");
        sender.className = "message-sender";
        sender.textContent = msg.role === "user" ? "You" : "Assistant";
        bubble.appendChild(sender);

        const content = document.createElement("div");
        content.className = "message-content";
        
        // Parse markdown for assistant messages, keep plain text for user queries
        if (msg.role === "assistant") {
          content.innerHTML = marked.parse(msg.content) as string;
        } else {
          content.textContent = msg.content;
        }
        bubble.appendChild(content);

        // Sources display with clear spacing and badges
        if (msg.role === "assistant" && msg.sources && msg.sources.length > 0) {
          const sourcesContainer = document.createElement("div");
          sourcesContainer.className = "message-sources";
          
          const label = document.createElement("span");
          label.className = "sources-label";
          label.textContent = "Sources:";
          sourcesContainer.appendChild(label);

          const tagsWrapper = document.createElement("div");
          tagsWrapper.className = "source-tags-wrapper";

          msg.sources.forEach((page: number) => {
            const tag = document.createElement("span");
            tag.className = "source-tag";
            tag.textContent = `Page ${page}`;
            tagsWrapper.appendChild(tag);
          });

          sourcesContainer.appendChild(tagsWrapper);
          bubble.appendChild(sourcesContainer);
        }

        row.appendChild(bubble);
        chatMessages.appendChild(row);
      });

      // Smooth scroll to bottom
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    // Append Thinking bubble
    function showThinkingIndicator() {
      const row = document.createElement("div");
      row.className = "message-row assistant thinking-row";
      row.id = "thinking-indicator";

      const bubble = document.createElement("div");
      bubble.className = "message-bubble thinking-bubble";

      const sender = document.createElement("div");
      sender.className = "message-sender";
      sender.textContent = "Assistant";
      bubble.appendChild(sender);

      const content = document.createElement("div");
      content.className = "message-content thinking-text";
      content.innerHTML = '<span class="pulse-dot"></span> Searching ChromaDB & generating answer...';
      bubble.appendChild(content);

      row.appendChild(bubble);
      chatMessages.appendChild(row);
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function removeThinkingIndicator() {
      const indicator = document.getElementById("thinking-indicator");
      if (indicator) indicator.remove();
    }

    // 4. Send Question to /api/chat
    chatForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const question = queryInput.value.trim();
      if (!question || isGenerating || !currentDocument) return;

      isGenerating = true;
      queryInput.value = "";
      queryInput.disabled = true;
      sendBtn.disabled = true;
      clearError();

      // Push user message
      messages.push({ role: "user", content: question });
      renderMessages();
      showThinkingIndicator();

      try {
        const res = await fetch(`${API_BASE}/api/chat`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            filename: currentDocument,
            question: question
          })
        });

        removeThinkingIndicator();

        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.detail || `Server error (${res.status})`);
        }

        const data = await res.json();
        messages.push({
          role: "assistant",
          content: data.answer,
          sources: data.sources || []
        });
      } catch (err: any) {
        removeThinkingIndicator();
        messages.push({
          role: "assistant",
          content: `⚠️ Request failed: ${err.message}`,
          sources: []
        });
        showError(`Chat error: ${err.message}`);
      } finally {
        isGenerating = false;
        renderMessages();
        queryInput.disabled = false;
        sendBtn.disabled = false;
        queryInput.focus();
      }
    });

    // 5. Clear Chat
    clearBtn.addEventListener("click", () => {
      messages = [];
      renderMessages();
      clearError();
    });

    // Initial load
    fetchDocuments();
  </script>

  <style>
    :root {
      --bg-color: #0b0f17;
      --card-bg: #111827;
      --card-border: #1f2937;
      --input-bg: #0d131f;
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
      --text-subtle: #64748b;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --primary-border: rgba(59, 130, 246, 0.25);
      --bubble-user: #1e3a5f;
      --bubble-assistant: #141c2c;
      --success-bg: rgba(6, 78, 59, 0.25);
      --success-border: #059669;
      --success-text: #34d399;
      --error-bg: rgba(127, 29, 29, 0.25);
      --error-border: #dc2626;
      --error-text: #f87171;
      --info-bg: rgba(30, 58, 138, 0.2);
      --info-border: #3b82f6;
      --info-text: #93c5fd;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: var(--font-sans);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    .app-container {
      max-width: 900px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      flex: 1;
    }

    /* Header */
    .app-header {
      text-align: center;
      padding: 1rem 0 0.5rem;
    }

    .badge {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      color: var(--primary);
      background: var(--info-bg);
      border: 1px solid var(--primary-border);
      padding: 0.25rem 0.65rem;
      border-radius: 9999px;
      margin-bottom: 0.75rem;
    }

    .app-header h1 {
      font-size: 2.25rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: #ffffff;
      margin-bottom: 0.35rem;
    }

    .subtitle {
      font-size: 0.95rem;
      color: var(--text-muted);
    }

    /* Cards */
    .card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
    }

    .card-header, .chat-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.85rem;
    }

    .section-label {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      color: var(--text-subtle);
    }

    /* Document Selector Row */
    .selector-row {
      display: flex;
      gap: 0.75rem;
      align-items: center;
    }

    .select-wrapper {
      flex: 1;
      position: relative;
    }

    select {
      width: 100%;
      background: var(--input-bg);
      border: 1px solid var(--card-border);
      color: var(--text-main);
      padding: 0.75rem 1rem;
      border-radius: 8px;
      font-size: 0.95rem;
      font-family: inherit;
      outline: none;
      cursor: pointer;
      appearance: none;
      background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%239ca3af' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
      background-repeat: no-repeat;
      background-position: right 1rem center;
      background-size: 1em;
    }

    select:focus {
      border-color: var(--primary);
    }

    /* Buttons */
    .btn {
      padding: 0.75rem 1.25rem;
      font-size: 0.9rem;
      font-weight: 600;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      font-family: inherit;
      transition: background 0.15s ease, opacity 0.15s ease;
      white-space: nowrap;
    }

    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .btn-primary {
      background: var(--primary);
      color: #ffffff;
    }

    .btn-primary:hover:not(:disabled) {
      background: var(--primary-hover);
    }

    .btn-secondary {
      background: #1f2937;
      color: var(--text-muted);
      border: 1px solid #374151;
    }

    .btn-secondary:hover:not(:disabled) {
      background: #374151;
      color: #ffffff;
    }

    .btn-sm {
      padding: 0.4rem 0.75rem;
      font-size: 0.78rem;
    }

    /* Status Banners */
    .status-banner {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-top: 1rem;
      padding: 0.85rem 1rem;
      border-radius: 8px;
      font-size: 0.88rem;
    }

    .status-banner.info {
      background: var(--info-bg);
      border: 1px solid var(--info-border);
      color: var(--info-text);
    }

    .status-banner.success {
      background: var(--success-bg);
      border: 1px solid var(--success-border);
      color: var(--success-text);
    }

    .status-banner.error {
      background: var(--error-bg);
      border: 1px solid var(--error-border);
      color: var(--error-text);
    }

    .status-indicator {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: currentColor;
    }

    .status-text {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }

    .meta-text {
      font-size: 0.8rem;
      opacity: 0.85;
    }

    .hidden {
      display: none !important;
    }

    /* Chat Section */
    .chat-card {
      display: flex;
      flex-direction: column;
      min-height: 480px;
    }

    .chat-messages {
      flex: 1;
      overflow-y: auto;
      max-height: 450px;
      padding: 0.5rem 0;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .empty-state {
      margin: auto;
      text-align: center;
      padding: 3rem 1rem;
      color: var(--text-subtle);
    }

    .empty-icon {
      font-size: 2.25rem;
      margin-bottom: 0.75rem;
      opacity: 0.7;
    }

    .empty-state h3 {
      color: var(--text-muted);
      font-size: 1.05rem;
      margin-bottom: 0.35rem;
    }

    .empty-state p {
      font-size: 0.85rem;
      max-width: 320px;
      margin: 0 auto;
    }

    /* Message Rows */
    .message-row {
      display: flex;
      width: 100%;
    }

    .message-row.user {
      justify-content: flex-end;
    }

    .message-row.assistant {
      justify-content: flex-start;
    }

    .message-bubble {
      max-width: 85%;
      padding: 1rem 1.25rem;
      border-radius: 12px;
      font-size: 0.94rem;
      line-height: 1.6;
    }

    .message-row.user .message-bubble {
      background: var(--bubble-user);
      color: #ffffff;
      border-bottom-right-radius: 3px;
      border: 1px solid #2b4c7e;
    }

    .message-row.assistant .message-bubble {
      background: var(--bubble-assistant);
      color: var(--text-main);
      border-bottom-left-radius: 3px;
      border: 1px solid #1e293b;
    }

    .message-sender {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 0.45rem;
      opacity: 0.6;
    }

    /* Rich Markdown Styles inside Assistant Message */
    .message-content {
      word-break: break-word;
    }

    .message-content p {
      margin-bottom: 0.65rem;
    }

    .message-content p:last-child {
      margin-bottom: 0;
    }

    .message-content ul,
    .message-content ol {
      padding-left: 1.4rem;
      margin-bottom: 0.75rem;
    }

    .message-content li {
      margin-bottom: 0.35rem;
      line-height: 1.6;
    }

    .message-content strong,
    .message-content b {
      font-weight: 600;
      color: #ffffff;
    }

    .message-content code {
      font-family: var(--font-mono);
      background: rgba(255, 255, 255, 0.08);
      padding: 0.15rem 0.4rem;
      border-radius: 4px;
      font-size: 0.88em;
      color: #93c5fd;
    }

    .message-content pre {
      background: #090d16;
      border: 1px solid #1e293b;
      border-radius: 8px;
      padding: 0.85rem 1rem;
      margin: 0.65rem 0;
      overflow-x: auto;
    }

    .message-content pre code {
      background: transparent;
      padding: 0;
      color: #e2e8f0;
    }

    .message-content blockquote {
      border-left: 3px solid var(--primary);
      padding-left: 0.85rem;
      margin: 0.5rem 0;
      color: var(--text-muted);
      font-style: italic;
    }

    /* Sources tags */
    .message-sources {
      margin-top: 0.9rem;
      padding-top: 0.75rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
    }

    .sources-label {
      color: var(--text-subtle);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-right: 0.2rem;
    }

    .source-tags-wrapper {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
    }

    .source-tag {
      background: rgba(59, 130, 246, 0.12);
      color: #93c5fd;
      border: 1px solid rgba(59, 130, 246, 0.3);
      padding: 0.2rem 0.55rem;
      border-radius: 6px;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.02em;
      display: inline-flex;
      align-items: center;
    }

    /* Thinking pulse */
    .pulse-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--primary);
      margin-right: 0.4rem;
      animation: pulse 1.2s infinite ease-in-out;
    }

    @keyframes pulse {
      0%, 100% { opacity: 0.3; transform: scale(0.8); }
      50% { opacity: 1; transform: scale(1.1); }
    }

    /* Input Form */
    .chat-input-form {
      margin-top: 1rem;
      display: flex;
      gap: 0.65rem;
      border-top: 1px solid var(--card-border);
      padding-top: 1rem;
    }

    .chat-input {
      flex: 1;
      background: var(--input-bg);
      border: 1px solid var(--card-border);
      color: var(--text-main);
      padding: 0.8rem 1rem;
      border-radius: 8px;
      font-size: 0.94rem;
      font-family: inherit;
      outline: none;
    }

    .chat-input:focus:not(:disabled) {
      border-color: var(--primary);
    }

    .chat-input:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* Footer */
    .app-footer {
      text-align: center;
      padding: 1rem 0;
      color: var(--text-subtle);
      font-size: 0.75rem;
      font-family: var(--font-mono);
    }

    @media (max-width: 640px) {
      .app-container {
        padding: 1rem;
      }
      .selector-row {
        flex-direction: column;
      }
      .btn {
        width: 100%;
      }
      .message-bubble {
        max-width: 95%;
      }
    }
  </style>
